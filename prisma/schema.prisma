generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(cuid())
  googleSubject     String     @unique
  email             String     @unique
  name              String
  profilePictureUrl String?
  subscriptionExpiresAt DateTime?
  suspendedAt       DateTime?
  stats             UserStats?
  driveCredential   GoogleDriveCredential?
  featureRequests   FeatureRequest[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("users")
}

model AdminEmail {
  email     String   @id
  createdAt DateTime @default(now())

  @@map("admin_emails")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminEmail  String   @db.VarChar(254)
  action      String   @db.VarChar(60)
  targetEmail String   @db.VarChar(254)
  details     String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetEmail, createdAt])
  @@map("admin_audit_logs")
}

model ContentSettings {
  id            String   @id
  quoteMode     String   @default("rotating") @db.VarChar(20)
  fixedQuoteId  String?
  updatedAt     DateTime @updatedAt

  @@map("content_settings")
}

model DailyQuote {
  id          String   @id @default(cuid())
  text        String   @db.VarChar(600)
  attribution String?  @db.VarChar(160)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, createdAt])
  @@map("daily_quotes")
}

model SharedResource {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(140)
  description String?  @db.VarChar(600)
  url         String   @db.VarChar(2048)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
  @@map("shared_resources")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(160)
  body      String   @db.VarChar(3000)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, updatedAt])
  @@map("announcements")
}

model FeatureRequest {
  id        String   @id @default(cuid())
  userId    String
  email     String
  subject   String   @db.VarChar(120)
  details   String   @db.VarChar(3000)
  adminReply String?  @db.VarChar(3000)
  repliedBy String?  @db.VarChar(254)
  repliedAt DateTime?
  status    String   @default("open") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("feature_requests")
}

model UserStats {
  userId          String   @id
  totalFard       Int      @default(0)
  onTimeFard      Int      @default(0)
  daysWithFard    Int      @default(0)
  completeFardDays Int     @default(0)
  bestStreakDays  Int      @default(0)
  rankingOptIn    Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model GoogleDriveCredential {
  userId                     String   @id
  refreshTokenEncrypted      String
  summaryFileId              String?
  lastDriveStatsSyncDay      String?
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_drive_credentials")
}
