generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(cuid())
  googleSubject     String     @unique
  email             String     @unique
  name              String
  profilePictureUrl String?
  subscriptionExpiresAt DateTime?
  stats             UserStats?
  driveCredential   GoogleDriveCredential?
  featureRequests   FeatureRequest[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("users")
}

model AdminEmail {
  email     String   @id
  createdAt DateTime @default(now())

  @@map("admin_emails")
}

model FeatureRequest {
  id        String   @id @default(cuid())
  userId    String
  email     String
  subject   String   @db.VarChar(120)
  details   String   @db.VarChar(3000)
  adminReply String?  @db.VarChar(3000)
  repliedBy String?  @db.VarChar(254)
  repliedAt DateTime?
  status    String   @default("open") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("feature_requests")
}

model UserStats {
  userId          String   @id
  totalFard       Int      @default(0)
  onTimeFard      Int      @default(0)
  daysWithFard    Int      @default(0)
  completeFardDays Int     @default(0)
  bestStreakDays  Int      @default(0)
  rankingOptIn    Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model GoogleDriveCredential {
  userId                     String   @id
  refreshTokenEncrypted      String
  summaryFileId              String?
  lastDriveStatsSyncDay      String?
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_drive_credentials")
}
