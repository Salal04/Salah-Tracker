# Neon pooled connection string for application queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Neon direct connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Google OAuth Web application credentials for offline Drive access
GOOGLE_CLIENT_SECRET="your-web-client-secret"
# Optional; defaults to http://localhost:3000/api/auth/google/callback in development
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-secret"
AUTH_SESSION_SECRET="long-random-server-only-secret"

# Public contact shown in the privacy policy; set this before publishing
PRIVACY_CONTACT_EMAIL=""

